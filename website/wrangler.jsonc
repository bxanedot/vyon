{
  "name": "vyon-web",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/listen/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LISTEN_ROOMS",
        "class_name": "ListenRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ListenRoom"
      ]
    }
  ]
}