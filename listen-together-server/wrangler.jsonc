{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vyon-listen-together",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-16",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ListenRoom"
      },
      {
        "name": "PARTIES",
        "class_name": "PartyRoom"
      }
    ]
  },
  "exports": {
    "ListenRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PartyRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
